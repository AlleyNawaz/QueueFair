# Copy to .env; use unique credentials. Docker Compose reads these values.
POSTGRES_USER=queuefair
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=queuefair_demo
DATABASE_URL=postgresql://queuefair:replace-with-random-local-password@127.0.0.1:5432/queuefair_demo
# Optional direct hosted connection for migrations; runtime still uses DATABASE_URL.
# Neon DATABASE_URL_UNPOOLED is also supported automatically.
DIRECT_URL=
# Separate database only. Tests require a database name ending in _test.
TEST_DATABASE_URL=postgresql://queuefair:replace-with-random-local-password@127.0.0.1:5432/queuefair_test
# Recommended explicit canonical origin; if omitted, same-origin requests are checked against the request host.
APP_ORIGIN=http://127.0.0.1:3000
# Recommended dedicated rate-limit HMAC key; DATABASE_URL is the secure fallback.
SESSION_SECRET=generate-at-least-32-random-characters
DEMO_MODE=true
ENABLE_DEMO_RESET=false
# Passwords required for seed; never commit real passwords. At least 12 characters.
DEMO_STAFF_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_HOSTEL_OFFICER_PASSWORD=
DEMO_SPORTS_OFFICER_PASSWORD=
# Demo-only short grace (10 seconds); use 120 for real operation.
DEMO_GRACE_SECONDS=10
# Office walk-in arrival window is 30 seconds in the demo; use 300 for a normal local setup.
DEMO_OFFICE_GRACE_SECONDS=30
